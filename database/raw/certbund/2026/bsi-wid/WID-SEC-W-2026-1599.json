      {
        "category": "description",
        "text": "Unbound ist ein validierender, rekursiver DNS-Resolver.",
        "title": "Produktbeschreibung"
      },
      {
        "category": "summary",
        "text": "Ein Angreifer kann mehrere Schwachstellen in Unbound ausnutzen, um einen Denial of Service Zustand herbeizuführen, um möglicherweise Code auszuführen und um nicht näher spezifizierte Auswirkungen zu verursachen.",
        "title": "Angriff"
      },
