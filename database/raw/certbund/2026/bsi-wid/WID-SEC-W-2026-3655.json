      {
        "category": "description",
        "text": "IBM InfoSphere Data Replication bietet protokollbasierte Änderungsdatenerfassung mit Transaktionsintegrität zur Unterstützung von Big-Data-Integration und Konsolidierung sowie für maßgeschneiderte Warehousing- und Analyseinitiativen.",
        "title": "Produktbeschreibung"
      },
      {
        "category": "summary",
        "text": "Ein Angreifer kann mehrere Schwachstellen in IBM InfoSphere Data Replication ausnutzen, um beliebigen Programmcode auszuführen, um einen Denial of Service Angriff durchzuführen und um einen Cross-Site Scripting Angriff durchzuführen.",
        "title": "Angriff"
      },
      {
        "category": "general",
        "text": "- Linux\n- Sonstiges\n- UNIX\n- Windows",
        "title": "Betroffene Betriebssysteme"
