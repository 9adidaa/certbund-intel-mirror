      {
        "category": "description",
        "text": "Check Point SmartConsole ist eine Management-Anwendung zur zentralen Verwaltung von Check Point Sicherheitsgateways und -produkten.",
        "title": "Produktbeschreibung"
      },
      {
        "category": "summary",
        "text": "Ein Angreifer kann mehrere Schwachstellen in Check Point SmartConsole ausnutzen, um erweiterte Berechtigungen, einschließlich Administratorzugriff, zu erlangen oder beliebigen Code auszuführen – sogar mit Root-Rechten.",
        "title": "Angriff"
      },
