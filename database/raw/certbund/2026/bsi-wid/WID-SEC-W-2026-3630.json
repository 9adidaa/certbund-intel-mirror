      {
        "category": "description",
        "text": "Apache Airflow ist eine Plattform zur programmatischen Erstellung, Planung und Überwachung von Workflows.",
        "title": "Produktbeschreibung"
      },
      {
        "category": "summary",
        "text": "Ein Angreifer kann mehrere Schwachstellen in verschiedenen Apache Airflow Providern ausnutzen, um Dateien zu manipulieren, um einen SQL-Injection Angriff durchzuführen, um Informationen offenzulegen und um Sicherheitsvorkehrungen zu umgehen.",
        "title": "Angriff"
      },
