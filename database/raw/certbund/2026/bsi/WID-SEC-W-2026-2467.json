      {
        "category": "description",
        "text": "SolarWinds Serv-U ist eine FTP-Server Software.",
        "title": "Produktbeschreibung"
      },
      {
        "category": "summary",
        "text": "Ein entfernter, hochprivilegierter Angreifer kann mehrere Schwachstellen in SolarWinds Serv-U ausnutzen, um beliebigen Code als Root auszuführen, Administratorrechte zu erlangen, Konten zu übernehmen, vertrauliche Informationen offenzulegen oder Cross-Site-Scripting-Angriffe durchzuführen.",
        "title": "Angriff"
      },
