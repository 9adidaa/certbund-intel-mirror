      {
        "category": "description",
        "text": "Adobe Experience Manager (AEM) ist eine Content-Management-Lösung für die Erstellung von Websites, mobilen Anwendungen und Formularen.",
        "title": "Produktbeschreibung"
      },
      {
        "category": "summary",
        "text": "Ein Angreifer kann mehrere Schwachstellen in Adobe Experience Manager ausnutzen, um seine Privilegien zu erhöhen, beliebigen Programmcode auszuführen oder Sicherheitsmaßnahmen zu umgehen.",
        "title": "Angriff"
      },
