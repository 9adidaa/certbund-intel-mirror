      {
        "category": "description",
        "text": "MongoDB ist ein Open-Source-Dokumentendatenbank.",
        "title": "Produktbeschreibung"
      },
      {
        "category": "summary",
        "text": "Ein Angreifer kann mehrere Schwachstellen in verschiedenen MongoDB Treibern und Komponenten ausnutzen, um Sicherheitsvorkehrungen zu umgehen, Informationen offenzulegen oder zu manipulieren, sowie um einen Denial of Service herbeizuführen.",
        "title": "Angriff"
      },
